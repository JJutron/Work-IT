# SANZERO Environment Variables Template
# 실제 사용 시 이 파일을 .env로 복사하고 실제 값으로 변경하세요
# 키는 커밋하지 마세요.

ENVIRONMENT=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SESSION_SECRET=your-session-secret
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# 실제 Auth 계정 사용 시 false. 테이블만 있고 계정이 없으면 true
DEMO_AUTH=false

# LLM: NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 법제처 Open API (open.law.go.kr 에서 발급). 키는 커밋하지 마세요.
LAW_OC=your-oc-key-here

# Next.js 홈 SSR이 FastAPI JSON을 부를 때
# - 호스트 `web/` next dev: http://localhost:8000
# - Docker next 서비스: http://web:8000 (compose가 설정)
FASTAPI_INTERNAL_URL=http://localhost:8000
