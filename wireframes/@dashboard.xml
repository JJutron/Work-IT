<?xml version="1.0" encoding="UTF-8"?>
<page name="dashboard" title="SANZERO editorial home">
  <layout type="main">
    <section class="hero">
      <eyebrow>SANZERO</eyebrow>
      <heading-display>
        <if user="logged_in">안녕하세요, {username}님</if>
        <else>산재 보상, 이제 AI가 함께합니다</else>
      </heading-display>
      <text class="text-muted">AI 기반 산업재해 보상 서비스. 계산부터 판례 분석, 노무사 상담까지.</text>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <card href="/compensation" border="hairline">
        <marker>[01]</marker>
        <title>보상금 계산</title>
        <link>계산하기 →</link>
      </card>
      <card href="/analysis/precedent" border="hairline">
        <marker>[02]</marker>
        <title>AI 판례 분석</title>
        <link>분석하기 →</link>
      </card>
      <card href="/lawyers/search" border="hairline">
        <marker>[03]</marker>
        <title>노무사 상담</title>
        <link>상담하기 →</link>
      </card>
      <card href="/analysis/disability" border="hairline">
        <marker>[04]</marker>
        <title>장해등급 예측</title>
        <link>예측하기 →</link>
      </card>
    </section>

    <section name="recent-activity">
      <title>최근 활동</title>
      <list>
        <item status="pending">보상금 계산</item>
        <item status="review">유사 판례 검색</item>
        <item status="approved">계정 설정</item>
      </list>
    </section>
  </layout>
</page>
