<?xml version="1.0" encoding="UTF-8"?>
<component name="header" title="SANZERO editorial header">
  <header class="bg-surface border-b border-border sticky top-0 z-50">
    <container class="max-w-7xl mx-auto px-4">
      <nav class="flex items-center justify-between h-16">
        <link href="/" class="flex items-center space-x-3">
          <icon name="shield-zero" class="w-8 h-8 text-ink" />
          <text class="text-lg font-bold text-ink tracking-tight">SANZERO</text>
        </link>
        <nav-menu class="hidden md:flex items-center space-x-8">
          <nav-item href="/compensation" class="text-sm text-muted hover:text-ink">보상금 관리</nav-item>
          <nav-item href="/analysis/precedent" class="text-sm text-muted hover:text-ink">AI 분석</nav-item>
          <nav-item href="/lawyers/search" class="text-sm text-muted hover:text-ink">노무사 서비스</nav-item>
        </nav-menu>
        <div class="flex items-center space-x-4">
          <conditional condition="user_not_logged_in">
            <link href="/auth/login" class="text-sm text-muted hover:text-ink">로그인</link>
            <link href="/auth/signup" class="bg-ink text-surface px-4 py-2 rounded-full text-sm">회원가입</link>
          </conditional>
          <conditional condition="user_logged_in">
            <dropdown>
              <avatar class="w-8 h-8 bg-ink text-surface rounded-full">{username[0]}</avatar>
              <dropdown-item href="/auth/profile">프로필 관리</dropdown-item>
              <dropdown-item action="logout">로그아웃</dropdown-item>
            </dropdown>
          </conditional>
        </div>
      </nav>
    </container>
  </header>
</component>
